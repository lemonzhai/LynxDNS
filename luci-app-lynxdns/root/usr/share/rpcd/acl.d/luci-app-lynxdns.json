{
	"luci-app-lynxdns": {
		"description": "Grant access to LynxDNS configuration",
		"read": {
			"uci": [ "lynxdns" ],
			"ubus": {
				"service": [ "list" ]
			},
			"file": {
				"/etc/lynxdns/*": [ "read" ],
				"/var/log/lynxdns.log": [ "read" ]
			}
		},
		"write": {
			"uci": [ "lynxdns" ],
			"file": {
				"/etc/lynxdns/*": [ "write" ]
			}
		}
	}
}
